# ---- Backend (copy to backend/.env) -------------------------------------------
# SQLite file (default: backend/route53.db). In Docker use sqlite:////data/route53.db
DATABASE_URL=
# Turso (hosted SQLite): DATABASE_URL=sqlite+libsql://<db>-<org>.turso.io?secure=true plus the token below
TURSO_AUTH_TOKEN=
# Random string; generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true when served over HTTPS (production); false for http://localhost
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000
# Create tables and demo data on first start
SEED_ON_START=true
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=password
LOG_LEVEL=INFO
# Amazon Q assistant: free key from https://console.groq.com (leave empty to switch the assistant off)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
ASSISTANT_DAILY_LIMIT=100

# ---- Frontend (copy to frontend/.env.local) ------------------------------------
# Where Next.js proxies /api/* to. Read at build time.
BACKEND_URL=http://127.0.0.1:8000
